# Copy this file to .env.local for local development, or configure these as real
# environment variables in your production host. Never commit an actual .env file —
# .gitignore already excludes .env* and /data/ (the local SQLite database directory).

# --- Site URL (used for SEO metadata, sitemap, canonical/OG URLs) -----------
# The production domain, no trailing slash. Falls back to a placeholder domain
# (lib/site.ts) if unset — set this for real before going live.
NEXT_PUBLIC_SITE_URL=https://www.mastersleadershipacademy.com

# --- Sessions (required) ---------------------------------------------------
# Secret used to sign admin session tokens (lib/auth.ts). Required in production —
# the app throws on startup if it's missing. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database ---------------------------------------------------------------
# Directory where the SQLite database file (academy.db) is stored (lib/db.ts).
# Defaults to ./data if unset. On serverless/ephemeral hosting (e.g. Vercel) this
# MUST point at a mounted persistent volume, or the database should be swapped for
# a hosted Postgres connection instead — see DEPLOYMENT.md.
DATABASE_DIR=./data

# --- Admin bootstrap (used by `npm run create-admin`) -----------------------
# Optional defaults for the create-admin script; can also be passed as CLI flags
# (--email, --password, --name, --role). See scripts/create-admin.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_ROLE=SUPER_ADMIN

# --- WhatsApp contact button (optional) --------------------------------------
# Full international number, digits only (e.g. 2348012345678). If unset, the
# floating WhatsApp button (components/WhatsAppButton.tsx) does not render.
# PLACEHOLDER BELOW — this is not a real Academy WhatsApp Business number. It's set
# so the button is visible during development/preview. Replace with the real number
# before shipping to production, or clear it to hide the button again.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# --- Social media links (optional) -------------------------------------------
# Full profile URLs shown as icons in the footer (components/SocialLinks.tsx,
# lib/social.ts). Facebook and Instagram are confirmed and hardcoded as defaults.
# LinkedIn and X currently fall back to placeholder handles built from the Academy
# name — set these once the Academy confirms its real handles.
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://web.facebook.com/LeadMastersAcademy
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/masters_leadership_academy/
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=

# --- Payments: Paystack (optional — donations & registration fees) ----------
# Get these from https://dashboard.paystack.com/#/settings/developer
# Never expose the secret key to the client; only the routes under app/api/payments/
# read it server-side.
PAYSTACK_SECRET_KEY=

# --- Payments: Flutterwave (optional — donations & registration fees) -------
# Get these from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=

# --- AI Chat Assistant (optional) --------------------------------------------
# Anthropic API key powering the floating FAQ chatbot (components/ChatWidget.tsx,
# app/api/chatbot/route.ts). Get one at https://console.anthropic.com/settings/keys.
# If unset, the widget still renders but shows a friendly "not configured" message.
ANTHROPIC_API_KEY=

# --- Web Push (optional, not yet wired to send notifications) ---------------
# Generate a key pair with `npm run generate-vapid-keys`. The public key is safe
# to expose client-side; keep the private key secret. Subscriptions are already
# collected and stored (lib/models.ts pushSubscriptions), but actually sending
# push messages is not implemented yet — see public/sw.js for details.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
